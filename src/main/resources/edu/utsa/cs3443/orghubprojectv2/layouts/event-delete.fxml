<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="308.0" prefWidth="506.0" styleClass="dialog-root" stylesheets="@../styles/orghub.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.orghubprojectv2.controller.EventDeleteController">
   <children>
      <BorderPane prefHeight="321.0" prefWidth="514.0">
         <center>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="dialog-root" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="93.0" fitWidth="93.0" pickOnBounds="true" preserveRatio="true" styleClass="icon">
                     <image>
                        <!-- Use '@' for local project files relative to the FXML location -->
                        <Image url="@../images/orghub-delete-trashcan.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="titleLabel" alignment="CENTER" prefHeight="67.0" prefWidth="224.0" styleClass="card-title" text="Delete This Event?" textAlignment="CENTER" wrapText="true">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="questionDeleteLabel" prefHeight="43.0" prefWidth="306.0" styleClass="card-text" text="{Meeting Name} will be permanently removed. Are you sure you want to remove this event?" textAlignment="CENTER" wrapText="true" />
                  <Separator prefHeight="46.0" prefWidth="494.0" />
                  <HBox alignment="TOP_CENTER" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Button fx:id="keepEventButton" cancelButton="true" mnemonicParsing="false" onAction="#keepEventOnClick" styleClass="secondary-button" text="Keep Event" />
                        <Button fx:id="deleteEventButton" defaultButton="true" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#deleteEventOnClick" styleClass="primary-button" text="Yes, Delete Event." />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </center></BorderPane>
   </children>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" spacing="12.0" styleClass="dialog-root" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.orghubprojectv2.controller.EventFormController">
   <children>
      <Label fx:id="headingLabel" styleClass="dialog-title" text="Create event" />
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Title" />
            <TextField fx:id="titleField" promptText="e.g. General Body Meeting" />
         </children>
      </VBox>
      <HBox spacing="12.0">
         <children>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Type" />
                  <ComboBox fx:id="typeComboBox" maxWidth="1.7976931348623157E308" promptText="Choose a type" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Date" />
                  <DatePicker fx:id="datePicker" maxWidth="1.7976931348623157E308" />
               </children>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-label" text="Time" />
                  <ComboBox fx:id="timeComboBox" maxWidth="1.7976931348623157E308" promptText="Pick a time" />
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Location" />
            <TextField fx:id="locationField" promptText="e.g. Student Union Room 2.02" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Organizer" />
            <TextField fx:id="organizerField" />
         </children>
      </VBox>
      <VBox spacing="4.0">
         <children>
            <Label styleClass="form-label" text="Description" />
            <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" />
         </children>
      </VBox>
      <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onCancelClick" styleClass="secondary-button" text="Cancel" />
            <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#onSaveClick" styleClass="primary-button" text="Save" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>

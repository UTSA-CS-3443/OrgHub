<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="460.0" spacing="12.0" styleClass="dialog-root" stylesheets="@../styles/orghub.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.orghubprojectv2.controller.EventDetailsController">
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="typeTagLabel" styleClass="type-tag-dark" text="MEETING" />
         </children>
      </HBox>
      <Label fx:id="titleLabel" styleClass="dialog-title" text="Event title" wrapText="true" />
      <HBox spacing="12.0">
         <children>
            <Label prefWidth="80.0" styleClass="detail-key" text="Date" />
            <Label fx:id="dateLabel" styleClass="detail-value" wrapText="true" />
         </children>
      </HBox>
      <HBox spacing="12.0">
         <children>
            <Label prefWidth="80.0" styleClass="detail-key" text="Time" />
            <Label fx:id="timeLabel" styleClass="detail-value" wrapText="true" />
         </children>
      </HBox>
      <HBox spacing="12.0">
         <children>
            <Label prefWidth="80.0" styleClass="detail-key" text="Location" />
            <Label fx:id="locationLabel" styleClass="detail-value" wrapText="true" />
         </children>
      </HBox>
      <HBox spacing="12.0">
         <children>
            <Label prefWidth="80.0" styleClass="detail-key" text="Organizer" />
            <Label fx:id="organizerLabel" styleClass="detail-value" wrapText="true" />
         </children>
      </HBox>
      <HBox spacing="12.0">
         <children>
            <Label prefWidth="80.0" styleClass="detail-key" text="About" />
            <Label fx:id="descriptionLabel" maxWidth="330.0" styleClass="detail-value" wrapText="true" />
         </children>
      </HBox>
      <Label fx:id="reminderLabel" maxWidth="1.7976931348623157E308" styleClass="reminder-box" wrapText="true" />
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="closeButton" cancelButton="true" defaultButton="true" mnemonicParsing="false" onAction="#onCloseClick" styleClass="primary-button" text="Close" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>

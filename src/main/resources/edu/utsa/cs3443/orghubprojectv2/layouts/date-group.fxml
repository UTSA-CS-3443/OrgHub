<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- One date heading plus however many event cards fall on that day.
     Load once per distinct date, then add EventCard.fxml nodes to cardsBox. -->

<VBox fx:controller="edu.utsa.cs3443.orghubprojectv2.controller.DateGroupController" spacing="8.0" styleClass="date-group" stylesheets="@app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER_LEFT">
         <padding>
            <Insets left="4.0" right="4.0" />
         </padding>
         <children>
            <Label fx:id="dateHeadingLabel" styleClass="date-heading" text="Sunday, November 8" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="eventCountLabel" styleClass="muted" text="1 event" />
         </children>
      </HBox>
      <VBox fx:id="cardsBox" spacing="10.0" />
   </children>
</VBox>

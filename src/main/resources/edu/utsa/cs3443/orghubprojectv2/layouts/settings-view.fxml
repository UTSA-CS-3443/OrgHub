<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane
        prefWidth="970.0"
        prefHeight="700.0"
        styleClass="settings-root"
        stylesheets="@../styles/settings.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="edu.utsa.cs3443.orghubprojectv2.controller.SettingsController">

    <center>
        <VBox spacing="24.0" styleClass="settings-page">
            <padding>
                <Insets top="38" right="48" bottom="38" left="48"/>
            </padding>

            <VBox spacing="6">
                <Label text="SETTINGS" styleClass="settings-caption"/>
                <Label text="Settings" styleClass="settings-title"/>
                <Label text="Manage your organization preferences and account settings."
                       styleClass="settings-subtitle"/>
            </VBox>

            <VBox spacing="18" styleClass="settings-card">
                <VBox spacing="5">
                    <Label text="Organization Details"
                           styleClass="section-title"/>
                    <Label text="Update your organization's basic information."
                           styleClass="section-description"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Organization Name"
                           styleClass="settings-label"/>
                    <TextField fx:id="organizationNameField"
                               promptText="Enter organization name"
                               styleClass="settings-field"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Contact Email"
                           styleClass="settings-label"/>
                    <TextField fx:id="contactEmailField"
                               promptText="Enter contact email"
                               styleClass="settings-field"/>
                </VBox>
            </VBox>

            <VBox spacing="18" styleClass="settings-card">
                <VBox spacing="5">
                    <Label text="Notifications"
                           styleClass="section-title"/>
                    <Label text="Choose which notifications you would like to receive."
                           styleClass="section-description"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Email Notifications"
                               styleClass="settings-label"/>
                        <Label text="Receive updates and announcements through email."
                               styleClass="section-description"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <CheckBox fx:id="emailNotificationsCheckBox"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button text="Save Settings"
                        onAction="#handleSave"
                        styleClass="primary-button"/>
            </HBox>

            <Label fx:id="statusLabel"
                   styleClass="status-label"
                   wrapText="true"/>

        </VBox>
    </center>
</BorderPane>